# Legal Metrology Compliance Platform Environment Configuration
PROJECT_NAME="Legal Metrology Packaged Commodity Compliance Platform"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=dev-insecure-legal-metrology-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for instant zero-dependency dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./legal_metrology.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_metrology

# Storage Settings
STORAGE_DIR=./storage

# Perception Engines
# OCR Engine: "paddleocr" (default, real OCR), "easyocr", or "mock" (tests only)
OCR_PROVIDER=paddleocr
PADDLE_OCR_LANG=en
PADDLE_USE_TEXTLINE_ORIENTATION=true

# Never silently substitute sample text when the real engine is unavailable.
OCR_ALLOW_MOCK_FALLBACK=false

# VLM Provider: "heuristic" (local visual analyser) or "none"
VLM_PROVIDER=heuristic

# Pia, the in-product assistant (optional).
# Get a free key at https://console.groq.com/keys
# When this is empty the assistant widget is hidden and nothing else changes.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
